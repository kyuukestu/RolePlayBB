[div=background: no-repeat center/cover url(https://media.discordapp.net/attachments/191374162978144257/1513707388337914050/Alola_artwork.png?ex=6a28b55c&is=6a2763dc&hm=9e9bae4ddf98d046afe17ae1c036711ab8ff1530e040617acf40976a4267f2c1&=&format=webp&quality=lossless); width: 80%; aspect-ratio: 1280/905; border: 2px solid rgba(120,180,220,.18); margin: auto;][/div]
[div=
